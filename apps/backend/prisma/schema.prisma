generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//// ENUMS

enum OwnerAccountStatus {
  PENDING
  APPROVED
  BLOCKED
  PENDING_DELETION
}

enum OwnerMemberRole {
  PRIMARY
  CO_OWNER
}

enum HouseStatus {
  OCCUPIED
  VACANT
  INACTIVE
}

enum TenantAssignmentStatus {
  ACTIVE
  NOTICE_PERIOD
  EXITED
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

//// CORE MODELS

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  isBlocked Boolean  @default(false)

  ownerMemberships OwnerAccountMember[]
  tenantProfile    TenantProfile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OwnerAccount {
  id        String   @id @default(cuid())
  name      String

  status OwnerAccountStatus @default(PENDING)

  deletionScheduledAt DateTime?
  deletionExecutedAt  DateTime?

  members OwnerAccountMember[]
  houses  House[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OwnerAccountMember {
  id String @id @default(cuid())

  userId         String
  ownerAccountId String
  role           OwnerMemberRole

  user         User         @relation(fields: [userId], references: [id])
  ownerAccount OwnerAccount @relation(fields: [ownerAccountId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, ownerAccountId])
}

model House {
  id String @id @default(cuid())

  ownerAccountId String
  name           String
  location       String
  maxTenants     Int

  status HouseStatus @default(VACANT)

  ownerAccount OwnerAccount @relation(fields: [ownerAccountId], references: [id])
  tenantAssignments TenantAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TenantProfile {
  id     String @id @default(cuid())
  userId String @unique

  user User @relation(fields: [userId], references: [id])

  assignments TenantAssignment[]

  createdAt DateTime @default(now())
}

model TenantAssignment {
  id String @id @default(cuid())

  tenantProfileId String
  houseId         String

  status TenantAssignmentStatus @default(ACTIVE)

  leaseStartDate DateTime
  leaseEndDate   DateTime?
  actualExitDate DateTime?

  deletionScheduledAt DateTime?

  tenantProfile TenantProfile @relation(fields: [tenantProfileId], references: [id])
  house         House         @relation(fields: [houseId], references: [id])

  receipts      Receipt[]
  issues        Issue[]
  leaveRequests LeaveRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Receipt {
  id String @id @default(cuid())

  tenantAssignmentId String
  fileUrl            String
  uploadedAt         DateTime @default(now())

  tenantAssignment TenantAssignment @relation(fields: [tenantAssignmentId], references: [id])
}

model Issue {
  id String @id @default(cuid())

  tenantAssignmentId String
  title              String
  description        String
  status             IssueStatus @default(OPEN)

  tenantAssignment TenantAssignment @relation(fields: [tenantAssignmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LeaveRequest {
  id String @id @default(cuid())

  tenantAssignmentId String
  reason             String
  requestedExitDate  DateTime
  approved           Boolean @default(false)

  tenantAssignment TenantAssignment @relation(fields: [tenantAssignmentId], references: [id])

  createdAt DateTime @default(now())
}

model ActivityLog {
  id String @id @default(cuid())

  entityType String
  entityId   String
  action     String

  performedByUserId String?
  metadata          Json?

  createdAt DateTime @default(now())
}