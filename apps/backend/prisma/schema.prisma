generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

//// ENUMS

enum OwnerAccountStatus {
  PENDING
  APPROVED
  BLOCKED
  PENDING_DELETION
}

enum OwnerMemberRole {
  PRIMARY
  CO_OWNER
}

enum HouseStatus {
  OCCUPIED
  VACANT
  INACTIVE
}

enum TenantAssignmentStatus {
  ACTIVE
  NOTICE_PERIOD
  EXITED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

//// CORE MODELS

model User {
  id        String  @id
  email     String  @unique
  name      String?
  isBlocked Boolean @default(false)

  ownerMemberships OwnerAccountMember[]
  tenantProfile    TenantProfile?
  sentInvitations  Invitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OwnerAccount {
  id   String @id @default(cuid())
  name String

  status               OwnerAccountStatus  @default(PENDING)
  statusBeforeDeletion OwnerAccountStatus?

  deletionScheduledAt DateTime?
  deletionExecutedAt  DateTime?

  members OwnerAccountMember[]
  houses  House[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OwnerAccountMember {
  id String @id @default(cuid())

  userId         String
  ownerAccountId String
  role           OwnerMemberRole

  user         User         @relation(fields: [userId], references: [id])
  ownerAccount OwnerAccount @relation(fields: [ownerAccountId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, ownerAccountId])
}

model House {
  id String @id @default(cuid())

  ownerAccountId String
  name           String
  location       String
  maxTenants     Int

  status HouseStatus @default(VACANT)

  ownerAccount      OwnerAccount       @relation(fields: [ownerAccountId], references: [id])
  tenantAssignments TenantAssignment[]
  invitations       Invitation[]
  issues            Issue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerAccountId, createdAt, id])
}

model TenantProfile {
  id     String @id @default(cuid())
  userId String @unique

  user User @relation(fields: [userId], references: [id])

  assignments TenantAssignment[]

  createdAt DateTime @default(now())
}

model TenantAssignment {
  id String @id @default(cuid())

  tenantProfileId String
  houseId         String

  status TenantAssignmentStatus @default(ACTIVE)

  leaseStartDate DateTime
  leaseEndDate   DateTime?
  actualExitDate DateTime?

  deletionScheduledAt DateTime?

  tenantProfile TenantProfile @relation(fields: [tenantProfileId], references: [id])
  house         House         @relation(fields: [houseId], references: [id])

  receipts      Receipt[]
  issues        Issue[]
  leaveRequests LeaveRequest[]
  invitation    Invitation?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantProfileId, houseId], where: { status: { not: "EXITED" } })
  @@index([houseId, createdAt, id])
  @@index([tenantProfileId, createdAt, id])
}

model Invitation {
  id String @id @default(cuid())

  houseId         String
  email           String
  invitedByUserId String

  leaseStartDate DateTime
  leaseEndDate   DateTime?

  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  respondedAt DateTime?

  acceptedAssignmentId String? @unique

  house              House             @relation(fields: [houseId], references: [id])
  invitedBy          User              @relation(fields: [invitedByUserId], references: [id])
  acceptedAssignment TenantAssignment? @relation(fields: [acceptedAssignmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([houseId, email], where: { status: "PENDING" })
  @@index([houseId, createdAt, id])
  @@index([houseId, status, createdAt, id])
  @@index([email, createdAt, id], where: { status: "PENDING" })
  @@index([invitedByUserId])
}

model Receipt {
  id String @id @default(cuid())

  tenantAssignmentId String
  amountCents        Int
  currency           String   @default("AUD")
  paidAt             DateTime
  note               String?
  fileUrl            String?

  tenantAssignment TenantAssignment @relation(fields: [tenantAssignmentId], references: [id])

  createdAt DateTime @default(now()) @map("uploadedAt")

  @@index([tenantAssignmentId, createdAt, id])
}

model Issue {
  id String @id @default(cuid())

  tenantAssignmentId String
  houseId            String
  title              String
  description        String
  status             IssueStatus @default(OPEN)

  tenantAssignment TenantAssignment @relation(fields: [tenantAssignmentId], references: [id])
  house            House            @relation(fields: [houseId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantAssignmentId, createdAt, id])
  @@index([tenantAssignmentId, status, createdAt, id])
  @@index([houseId, createdAt, id])
  @@index([houseId, status, createdAt, id])
}

model LeaveRequest {
  id String @id @default(cuid())

  tenantAssignmentId String
  reason             String
  requestedExitDate  DateTime
  approved           Boolean  @default(false)

  tenantAssignment TenantAssignment @relation(fields: [tenantAssignmentId], references: [id])

  createdAt DateTime @default(now())
}

model ActivityLog {
  id String @id @default(cuid())

  entityType String
  entityId   String
  action     String

  performedByUserId String?
  metadata          Json?

  createdAt DateTime @default(now())
}
