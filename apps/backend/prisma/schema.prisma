generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

//// ENUMS

enum OwnerAccountStatus {
  PENDING
  APPROVED
  BLOCKED
  PENDING_DELETION
}

enum OwnerMemberRole {
  PRIMARY
  CO_OWNER
}

enum HouseStatus {
  OCCUPIED
  VACANT
  INACTIVE
}

enum TenantAssignmentStatus {
  ACTIVE
  NOTICE_PERIOD
  EXITED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// Plans sold through Stripe. ENTERPRISE is not a Stripe plan: it is Subscription.enterprise.
enum BillingPlan {
  STARTER
  GROWTH
  PRO
}

enum BillingInterval {
  MONTH
  YEAR
}

//// CORE MODELS

model User {
  id        String  @id
  email     String  @unique
  name      String?
  isBlocked Boolean @default(false)

  ownerMemberships      OwnerAccountMember[]
  tenantProfile         TenantProfile?
  sentInvitations       Invitation[]
  sentMemberInvitations MemberInvitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OwnerAccount {
  id   String @id @default(cuid())
  name String

  status               OwnerAccountStatus  @default(PENDING)
  statusBeforeDeletion OwnerAccountStatus?

  deletionScheduledAt DateTime?
  deletionExecutedAt  DateTime?

  members           OwnerAccountMember[]
  memberInvitations MemberInvitation[]
  houses            House[]
  subscription      Subscription?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt, id])
  @@index([deletionScheduledAt])
}

// Billing state for one owner account, mirrored from Stripe by the webhook. Kept apart from
// OwnerAccount.status: entitlement is computed from both in lib/entitlement.js.
model Subscription {
  id             String @id @default(cuid())
  ownerAccountId String @unique

  stripeCustomerId         String? @unique
  stripeSubscriptionId     String? @unique
  pendingCheckoutSessionId String? @unique

  plan              BillingPlan?
  interval          BillingInterval?
  // Raw Stripe status (trialing, active, past_due, canceled, unpaid, ...). A string, not an
  // enum, because Stripe adds statuses without a major API change.
  stripeStatus      String?
  trialEnd          DateTime?
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean          @default(false)

  // Set once, the first time a subscription with a trial is seen; one trial per account ever.
  trialUsedAt DateTime?

  // Set by a super admin: no Stripe price, no tenant limit.
  enterprise Boolean @default(false)

  // When billing made the account read-only; cleared when access returns. Used by the
  // later grace-period and deletion job.
  readOnlySince DateTime?

  ownerAccount OwnerAccount @relation(fields: [ownerAccountId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([readOnlySince])
}

// Stripe event ids already processed, so a redelivered webhook is applied once.
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())

  @@index([processedAt])
}

model OwnerAccountMember {
  id String @id @default(cuid())

  userId         String
  ownerAccountId String
  role           OwnerMemberRole

  user         User         @relation(fields: [userId], references: [id])
  ownerAccount OwnerAccount @relation(fields: [ownerAccountId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, ownerAccountId])
  // At most one PRIMARY per account. Never use the generated `ownerAccountId` unique input:
  // it is not unique across all rows (coding standards, section 8).
  @@unique([ownerAccountId], where: { role: "PRIMARY" })
  @@index([ownerAccountId, createdAt, id])
}

// A PRIMARY member's invitation to join the account as CO_OWNER, accepted by the user whose
// verified email matches. Same lifecycle as Invitation.
model MemberInvitation {
  id String @id @default(cuid())

  ownerAccountId  String
  email           String
  invitedByUserId String

  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  respondedAt DateTime?

  ownerAccount OwnerAccount @relation(fields: [ownerAccountId], references: [id])
  invitedBy    User         @relation(fields: [invitedByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerAccountId, email], where: { status: "PENDING" })
  @@index([ownerAccountId, createdAt, id])
  @@index([ownerAccountId, status, createdAt, id])
  @@index([email, createdAt, id], where: { status: "PENDING" })
  @@index([invitedByUserId])
}

model House {
  id String @id @default(cuid())

  ownerAccountId String
  name           String
  location       String
  maxTenants     Int

  status HouseStatus @default(VACANT)

  ownerAccount      OwnerAccount       @relation(fields: [ownerAccountId], references: [id])
  tenantAssignments TenantAssignment[]
  invitations       Invitation[]
  issues            Issue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerAccountId, createdAt, id])
}

model TenantProfile {
  id     String @id @default(cuid())
  userId String @unique

  user User @relation(fields: [userId], references: [id])

  assignments TenantAssignment[]

  createdAt DateTime @default(now())
}

model TenantAssignment {
  id String @id @default(cuid())

  tenantProfileId String
  houseId         String

  status TenantAssignmentStatus @default(ACTIVE)

  leaseStartDate DateTime
  leaseEndDate   DateTime?
  actualExitDate DateTime?

  tenantProfile TenantProfile @relation(fields: [tenantProfileId], references: [id])
  house         House         @relation(fields: [houseId], references: [id])

  receipts      Receipt[]
  issues        Issue[]
  leaveRequests LeaveRequest[]
  invitation    Invitation?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantProfileId, houseId], where: { status: { not: "EXITED" } })
  @@index([houseId, createdAt, id])
  @@index([tenantProfileId, createdAt, id])
}

model Invitation {
  id String @id @default(cuid())

  houseId         String
  email           String
  invitedByUserId String

  leaseStartDate DateTime
  leaseEndDate   DateTime?

  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  respondedAt DateTime?

  acceptedAssignmentId String? @unique

  house              House             @relation(fields: [houseId], references: [id])
  invitedBy          User              @relation(fields: [invitedByUserId], references: [id])
  acceptedAssignment TenantAssignment? @relation(fields: [acceptedAssignmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([houseId, email], where: { status: "PENDING" })
  @@index([houseId, createdAt, id])
  @@index([houseId, status, createdAt, id])
  @@index([email, createdAt, id], where: { status: "PENDING" })
  @@index([invitedByUserId])
}

model Receipt {
  id String @id @default(cuid())

  tenantAssignmentId String
  amountCents        Int
  currency           String   @default("AUD")
  paidAt             DateTime
  note               String?
  fileUrl            String?

  tenantAssignment TenantAssignment @relation(fields: [tenantAssignmentId], references: [id])

  createdAt DateTime @default(now()) @map("uploadedAt")

  @@index([tenantAssignmentId, createdAt, id])
}

model Issue {
  id String @id @default(cuid())

  tenantAssignmentId String
  houseId            String
  title              String
  description        String
  status             IssueStatus @default(OPEN)

  tenantAssignment TenantAssignment @relation(fields: [tenantAssignmentId], references: [id])
  house            House            @relation(fields: [houseId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantAssignmentId, createdAt, id])
  @@index([tenantAssignmentId, status, createdAt, id])
  @@index([houseId, createdAt, id])
  @@index([houseId, status, createdAt, id])
}

model LeaveRequest {
  id String @id @default(cuid())

  tenantAssignmentId String
  reason             String
  requestedExitDate  DateTime
  approved           Boolean  @default(false)

  tenantAssignment TenantAssignment @relation(fields: [tenantAssignmentId], references: [id])

  createdAt DateTime @default(now())

  @@index([tenantAssignmentId])
}

model ActivityLog {
  id String @id @default(cuid())

  entityType String
  entityId   String
  action     String

  performedByUserId String?
  metadata          Json?

  createdAt DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([performedByUserId])
}
