{
  "name": "rental-cms-backend",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "main": "src/index.js",
  "license": "MIT",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "worker": "node --env-file-if-exists=.env src/worker.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "admin:grant-super-admin": "node --env-file-if-exists=.env scripts/superAdmin.js grant",
    "admin:revoke-super-admin": "node --env-file-if-exists=.env scripts/superAdmin.js revoke",
    "stripe:sync-plans": "node --env-file-if-exists=.env scripts/stripeSyncPlans.js",
    "test": "node --env-file=.env.test --test --test-concurrency=1 --test-global-setup=test/globalSetup.js \"test/**/*.test.js\"",
    "test:db:migrate": "node --env-file=.env.test scripts/testDbMigrate.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1175.0",
    "@aws-sdk/s3-request-presigner": "3.1175.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bullmq": "6.7.8",
    "dotenv": "^17.4.2",
    "firebase-admin": "^14.5.0",
    "graphql": "^17.0.2",
    "graphql-yoga": "^6.0.1",
    "ioredis": "6.0.0",
    "stripe": "23.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26",
    "prisma": "^7.10.1",
    "typescript": "^5.9.3"
  }
}
